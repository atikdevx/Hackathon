# Copy to .env and fill in values. Never commit .env.
# --- LLM (required for POST /optimize-energy) ---
# openai (default), openai_compatible (same client, any OpenAI-compatible server) or anthropic
LLM_PROVIDER=openai
# Default for openai: gpt-5.6-terra (cheaper/faster: gpt-5.6-luna; stronger: gpt-5.6-sol)
LLM_MODEL=gpt-5.6-terra
# API key for the provider (OPENAI_API_KEY / ANTHROPIC_API_KEY are also read as fallbacks)
LLM_API_KEY=
# Leave empty for the OpenAI API; set for a proxy or another OpenAI-compatible server
LLM_BASE_URL=
# Per-attempt model timeout in seconds
LLM_TIMEOUT_SECONDS=12
# Attempts per request (second attempt is a guardrail repair turn)
LLM_MAX_ATTEMPTS=2
# Reasoning effort: none | low | medium | high  (OpenAI reasoning_effort / Claude effort)
LLM_EFFORT=low
# Anthropic only: server-side refusal fallbacks on Claude Opus 5 (true/false)
LLM_ENABLE_FALLBACKS=true
# In-memory interpretation cache entries (0 disables)
LLM_CACHE_SIZE=256
# --- Server ---
PORT=8000
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
