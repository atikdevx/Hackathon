# Copy to .env and fill in values. Never commit .env.
# --- LLM (required for POST /optimize-energy) ---
# gemini (default), openai / openai_compatible (any OpenAI-compatible server) or anthropic
LLM_PROVIDER=gemini
# Default for gemini: gemini-3.5-flash-lite (fast, measured ~1-3 s)
LLM_MODEL=gemini-3.5-flash-lite
# Comma-separated backups used automatically while the primary is overloaded/out of quota/timing out
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# API key for the provider (get a Gemini key at https://aistudio.google.com/apikey).
# GEMINI_API_KEY / GOOGLE_API_KEY (or OPENAI_API_KEY / ANTHROPIC_API_KEY) are also read as fallbacks.
LLM_API_KEY=
# Leave empty for the provider's default endpoint; set for a proxy or another OpenAI-compatible server
LLM_BASE_URL=
# Per-attempt model timeout in seconds
LLM_TIMEOUT_SECONDS=8
# Attempts per request (retries go to a fallback model or are guardrail repair turns); total LLM time is capped at 25 s
LLM_MAX_ATTEMPTS=3
# Thinking effort: minimal | low | medium | high  (Gemini 3 thinkingLevel / OpenAI reasoning_effort / Claude effort); none = provider default
LLM_EFFORT=low
# Anthropic only: server-side refusal fallbacks on Claude Opus 5 (true/false)
LLM_ENABLE_FALLBACKS=true
# In-memory interpretation cache entries (0 disables)
LLM_CACHE_SIZE=256
# --- Server ---
PORT=8000
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
