# Copy to .env and fill in values. Never commit .env.
# --- LLM (required for POST /optimize-energy) ---
# anthropic (default) or openai_compatible
LLM_PROVIDER=anthropic
# Default for anthropic: claude-opus-5 (lower latency: claude-sonnet-5 or claude-haiku-4-5)
LLM_MODEL=claude-opus-5
# API key for the provider (ANTHROPIC_API_KEY / OPENAI_API_KEY are also read as fallbacks)
LLM_API_KEY=
# Only for openai_compatible (e.g. https://api.groq.com/openai/v1) or a proxy
LLM_BASE_URL=
# Per-attempt model timeout in seconds
LLM_TIMEOUT_SECONDS=12
# Attempts per request (second attempt is a guardrail repair turn)
LLM_MAX_ATTEMPTS=2
# Claude effort level: low | medium | high | none
LLM_EFFORT=low
# Server-side refusal fallbacks on Claude Opus 5 (true/false)
LLM_ENABLE_FALLBACKS=true
# In-memory interpretation cache entries (0 disables)
LLM_CACHE_SIZE=256
# --- Server ---
PORT=8000
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
